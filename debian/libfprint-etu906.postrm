#!/bin/sh
set -e

case "$1" in
	remove|purge)
		if command -v systemctl >/dev/null 2>&1 && \
			systemctl show --property=Version >/dev/null 2>&1; then
			systemctl daemon-reload >/dev/null 2>&1 || true
			if systemctl --quiet is-active fprintd.service >/dev/null 2>&1; then
				systemctl try-restart fprintd.service >/dev/null 2>&1 || true
			fi
		fi
		;;
esac

exit 0
